# Port des HTTP-Servers
PORT=3000

# Zeitserver für GET /time
NTP_SERVER=pool.ntp.org
# Maximale Dauer einer NTP-Abfrage in Millisekunden (DNS und UDP zusammen)
NTP_TIMEOUT_MS=3000
# So lange gilt ein Sync und so lange pausieren neue Versuche nach einem Fehlschlag
# (Millisekunden). 0 synchronisiert bei jedem Request.
NTP_CACHE_MS=60000
